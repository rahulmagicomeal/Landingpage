node_modules/

# Lead storage written by server.js — repo root only.
# NOTE: this pattern MUST keep its leading slash. A bare `data/` matches a
# directory named `data` at ANY depth, which silently excluded src/data/
# (config.js, company.js, content.js) and broke the Vercel build.
/data/

*.log

# The upload bundle is a build artefact, rebuilt by scripts, not source.
upload-to-corporate-catering-mumbai.zip
upload-changed-files.zip
